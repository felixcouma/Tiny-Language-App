# ----------------------------------------------------------------------------
# Optional configuration. The app works with NO keys (device voice + Wikimedia
# photos). Copy this file to ".env" to enable upgrades, then restart `npm run dev`
# (or add the same names as repo "Variables/Secrets" for the deployed site).
# ----------------------------------------------------------------------------

# === Premium natural voice (recommended path: a secret-keeping proxy) ===
# Point this at your Cloudflare Worker (see docs/PREMIUM_VOICE_SETUP.md).
# This keeps your API key SECRET — safe for the public site.
VITE_TTS_PROXY_URL=

# --- Direct mode (LOCAL/DEV ONLY) ---
# Calls ElevenLabs straight from the browser. Do NOT use for the public site:
# the key would be visible in the app bundle. Handy only for local testing.
VITE_ELEVENLABS_KEY=
VITE_ELEVENLABS_VOICE=EXAVITQu4vr4xnSDxMaL

# === Curated photos (optional) — otherwise keyless Wikimedia photos are used ===
VITE_UNSPLASH_KEY=
VITE_PEXELS_KEY=

# === Parent feedback form (pilot) ===
# A Tally or Google Form URL. When set, a "Share feedback" button appears in the
# (gated) Parent area so families can tell us what works. Leave blank to hide it.
# Set it locally in .env, or as a Vercel/Pages env var for the deployed site.
VITE_FEEDBACK_URL=
